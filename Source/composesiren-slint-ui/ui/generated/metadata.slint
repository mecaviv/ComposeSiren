    default-value: float,
    midi: MidiKind,
    cc: int,
    widget: WidgetKind,
    section: int,
    position: int,
    required-option: string,
}

export struct SectionMeta {
    id: string,
    parameter-class: ParameterClass,
    title: string,
}

export struct SirenMeta {
    id: string,
    strip-colour: color,
    category-default: bool,
}

