export global Theme {
    // Accent: knob arcs, the held keyboard key, selections.
    out property <color> colour-orange-mecanique: #ff9900;
    // Background of the overlay panels.
    out property <color> colour-dark-transparent-background: #283541f2;
    // Background of a siren strip.
    out property <color> colour-background-strip-grey: #314159;
    // First colour of the strip ramp (the lowest siren).
    out property <color> colour-siren-ramp-dark-blue: #4650c8;
    // Last colour of the strip ramp.
    out property <color> colour-siren-ramp-light-blue: #00b4c8;
    // Siren palette.
    out property <color> colour-siren-ramp-dark-green: #3c8c28;
    // Siren palette.
    out property <color> colour-siren-ramp-light-green: #78b428;
    // Siren palette.
    out property <color> colour-siren-ramp-sunny-yellow: #d7b700;
    // Siren palette.
    out property <color> colour-siren-ramp-light-orange: #ff7f00;
    // Siren palette.
    out property <color> colour-siren-ramp-dark-orange: #ff4500;
    // Keyboard level meter: low.
    out property <color> colour-midi-keyboard-low-level-red: #800000;
    // Keyboard level meter: middle.
    out property <color> colour-midi-keyboard-mid-level-red: #ff0000;
    // Keyboard level meter: high.
    out property <color> colour-midi-keyboard-high-level-red: #ff6600;
    // Keyboard level meter: the dB range separators.
    out property <color> colour-midi-keyboard-db-range-separator-blue: #0000ff;
    // Width of the siren title cell at the left of a strip.
    out property <length> strip-title-area-width: 70.0px;
    // Font size of the siren title.
    out property <length> strip-title-font-size: 13.0px;
    // Corner radius of a strip.
    out property <length> strip-corner-size: 10.0px;
    // Gap between the cells of a strip.
    out property <length> strip-spacer-size: 2.0px;
    // Height of a section title.
    out property <length> strip-group-label-height: 16.0px;
    // Font size of a section title.
    out property <length> strip-group-label-font-size: 12.0px;
    // Height of a knob caption (two lines: the label, then the CC number).
    out property <length> strip-slider-label-height: 28.0px;
    // Font size of a knob caption.
    out property <length> strip-slider-label-font-size: 11.5px;
    // Smallest height of a knob.
    out property <length> strip-min-slider-height: 62.0px;
    // Smallest height of a whole strip.
    out property <length> strip-min-full-strip-height: 100.0px;
    // Smallest width of a knob cell.
    out property <length> strip-min-knob-slider-width: 47.0px;
    // Smallest width of an up/down value cell.
    out property <length> strip-min-inc-dec-slider-width: 70.0px;
    // Width of the knob track.
    out property <length> strip-knob-indicator-off-thickness: 2.0px;
    // Width of the knob value arc.
    out property <length> strip-knob-indicator-on-thickness: 4.0px;
    // Initial width of the OneSiren editor.
    out property <length> editor-one-siren-width: 754.0px;
    // Initial height of the OneSiren editor.
    out property <length> editor-one-siren-height: 200.0px;
}
