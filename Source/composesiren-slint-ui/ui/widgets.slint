// Controls of the siren strip, after ComposeSirenCore/Components/LookAndFeels.h (KnobLAF, CentredKnobLAF,
// IncDecLAF): a white knob with a grey track and a white value arc, and up/down arrows with a value box.

// Rotary range of JUCE's default slider: from 7 o'clock to 5 o'clock (-144 deg to +144 deg from 12 o'clock).
global Rotary {
    out property <angle> start: -144deg;
    out property <angle> span: 288deg;
}

// An arc of the 100x100 viewbox circle of radius `r`, from angle `from` to `to` (clockwise, 0 = 12 o'clock).
component Arc inherits Path {
    in property <angle> from;
    in property <angle> to;
    in property <float> r: 42;
    viewbox-width: 100;
    viewbox-height: 100;
    fill: transparent;
    stroke-line-cap: round;
    MoveTo { x: 50 + root.r * sin(root.from); y: 50 - root.r * cos(root.from); }
    ArcTo {
        x: 50 + root.r * sin(root.to);
        y: 50 - root.r * cos(root.to);
        radius-x: root.r;
        radius-y: root.r;
        large-arc: root.to - root.from > 180deg;
        sweep: true;
    }
}

// A rotary knob. Drag up/down (200 px for the whole range), wheel steps, double-click resets.
// `changed` reports raw values; the Rust side snaps them to the step and clamps them.
export component Knob inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 127;
    in property <float> step: 1;
    in property <float> default-value;
    in property <bool> centred;
    in property <string> text;
    in property <color> fill: #f5f5f5;
    callback changed(float);
    callback gesture(bool);

    property <float> pos: (root.value - root.minimum) / (root.maximum - root.minimum);
    property <angle> angle: Rotary.start + Rotary.span * root.pos;
    property <angle> origin: root.centred ? 0deg : Rotary.start;
    property <length> size: min(root.width, root.height - 16px);
    property <float> drag-from;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: root.size;
            Arc {
                width: root.size; height: root.size;
                from: Rotary.start; to: Rotary.start + Rotary.span;
                stroke: #00000040; stroke-width: 3px;
            }
            if abs((root.angle - root.origin) / 1deg) > 1 : Arc {
                width: root.size; height: root.size;
                from: min(root.origin, root.angle); to: max(root.origin, root.angle);
                stroke: root.fill; stroke-width: 3px;
            }
            body := Rectangle {
                width: root.size * 0.62; height: self.width;
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                // Solid fills: the software renderer (the plugin path) does not clip gradients to border-radius.
                background: #d4d4d4;
                drop-shadow-blur: 3px; drop-shadow-color: #00000070; drop-shadow-offset-y: 1px;
                Rectangle {
                    width: parent.width - 4px; height: self.width; border-radius: self.width / 2;
                    background: #f4f4f4;
                }
                Rectangle {
                    width: 4px; height: 4px; border-radius: 2px;
                    background: #26303d;
                    x: parent.width / 2 + parent.width * 0.32 * sin(root.angle) - self.width / 2;
                    y: parent.height / 2 - parent.height * 0.32 * cos(root.angle) - self.height / 2;
                }
            }
        }
        Text {
            text: root.text;
            color: white; font-size: 12px;
            horizontal-alignment: center;
        }
    }

    TouchArea {
        mouse-cursor: ns-resize;
        pointer-event(e) => {
            if e.button == PointerEventButton.left {
                if e.kind == PointerEventKind.down { root.drag-from = root.value; root.gesture(true); }
                if e.kind == PointerEventKind.up { root.gesture(false); }
            }
        }
        moved => {
            if self.pressed {
                root.changed(root.drag-from + (self.pressed-y - self.mouse-y) / 200px * (root.maximum - root.minimum));
            }
        }
        double-clicked => {
            root.gesture(true);
            root.changed(root.default-value);
            root.gesture(false);
        }
        scroll-event(e) => {
            root.gesture(true);
            root.changed(root.value + (e.delta-y > 0 ? 1 : -1) * max(root.step, (root.maximum - root.minimum) / 100));
            root.gesture(false);
            accept
        }
    }
}

component Arrow inherits Rectangle {
    in property <bool> up;
    callback clicked;
    width: 26px; height: 22px;
    Path {
        width: 100%; height: 100%;
        viewbox-width: 26; viewbox-height: 22;
        fill: ta.pressed ? #c8c8c8 : #f5f5f5;
        stroke: #00000060; stroke-width: 1px;
        MoveTo { x: 2; y: root.up ? 20 : 2; }
        LineTo { x: 24; y: root.up ? 20 : 2; }
        LineTo { x: 13; y: root.up ? 2 : 20; }
        Close { }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Up/down arrows and the value, for stepped parameters (bend range, transpose).
export component Spin inherits Rectangle {
    in property <float> value;
    in property <float> step: 1;
    in property <string> text;
    callback changed(float);
    callback gesture(bool);
    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Arrow { up: true; clicked => { root.gesture(true); root.changed(root.value + root.step); root.gesture(false); } }
            Arrow { up: false; clicked => { root.gesture(true); root.changed(root.value - root.step); root.gesture(false); } }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 34px; height: 20px;
                border-radius: 5px;
                background: white;
                border-width: 1px; border-color: #00000060;
                Text { text: root.text; color: black; font-size: 12px; }
            }
        }
    }
}

// A titled, rounded group of the strip (GuiCellGroup).
export component Group inherits Rectangle {
    in property <string> title;
    in property <color> colour;
    border-radius: 8px;
    background: @linear-gradient(180deg, root.colour.brighter(15%) 0%, root.colour 100%);
    VerticalLayout {
        padding: 4px;
        padding-top: 2px;
        spacing: 0px;
        Text {
            text: root.title;
            height: 18px;
            color: white; font-size: 13px; font-weight: 700;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 4px;
            @children
        }
    }
}

// The dark rounded buttons of the header (Options, menus) and the red Reset.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: #2a2f38;
    callback clicked;
    min-width: txt.preferred-width + 24px;
    height: 24px;
    border-radius: 7px;
    background: ta.pressed ? root.tint.darker(30%) : (ta.has-hover ? root.tint.brighter(20%) : root.tint);
    border-width: 1px; border-color: #ffffff90;
    txt := Text { text: root.text; color: white; font-size: 13px; }
    ta := TouchArea { clicked => { root.clicked(); } }
}
